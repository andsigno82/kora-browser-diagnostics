{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andsigno82/kora-browser-diagnostics/protocol/v1/schema/prepare-diagnostics.json",
  "title": "Browser Diagnostics prepare delivery",
  "type": "object",
  "additionalProperties": false,
  "required": ["deliveryId", "projectId", "sessionId", "pageUrl", "events"],
  "properties": {
    "deliveryId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,96}$" },
    "projectId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "pageUrl": { "type": "string", "pattern": "^https?://" },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timestamp", "level", "message"],
        "properties": {
          "timestamp": { "type": "string", "maxLength": 128 },
          "level": { "type": "string", "maxLength": 64 },
          "message": { "type": "string", "maxLength": 16384 },
          "stack": { "type": "string", "maxLength": 16384 },
          "source": { "type": "string", "maxLength": 16384 }
        }
      }
    }
  }
}

