{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andsigno82/kora-browser-diagnostics/protocol/v1/schema/hello.json",
  "title": "Browser Diagnostics protocol hello",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "extensionVersion",
    "protocolVersion",
    "minimumKoraVersion",
    "browserFamily"
  ],
  "properties": {
    "extensionVersion": { "type": "string", "minLength": 1 },
    "protocolVersion": { "const": 1 },
    "minimumKoraVersion": { "const": "1.5.0" },
    "browserFamily": { "enum": ["chromium", "firefox"] }
  }
}

